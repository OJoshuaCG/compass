# Preparación UNA SOLA VEZ de la base de datos de PRUEBAS externa (roles, migraciones, organización).
# Copia este archivo a `.env.setup.local` (git lo ignora) y llena los valores. Guía: docs/deployment.md §1.1.
# Va separado de `.env.local` a propósito: la API no debe arrancar con credenciales que puedan
# crear roles, migrar o dar de alta organizaciones.

# Administrador del clúster (o dueño de la base con CREATEROLE): solo para `pnpm local:bootstrap`.
DATABASE_URL=postgres://<admin>:<contraseña>@<host>:5432/<base>?sslmode=require

# Rol de migraciones, después de darle LOGIN y contraseña: para `pnpm local:migrate`.
MIGRATION_DATABASE_URL=postgres://iam_migrator:<contraseña>@<host>:5432/<base>?sslmode=require

# Alta de la organización de pruebas con su Raíz: para `pnpm local:provision`.
# Necesita una conexión de administración (el rol `iam_app` no puede crear organizaciones).
PROVISION_DATABASE_URL=postgres://<admin>:<contraseña>@<host>:5432/<base>?sslmode=require
ORG_NAME=Organización de pruebas
# Minúsculas, dígitos y guiones; de 2 a 63 caracteres.
ORG_SLUG=pruebas
ROOT_EMAIL=raiz@pruebas.example
ROOT_NAME=Raíz de pruebas
