# Variables de ejecución de la API desplegada en Dokploy. Guía: docs/deployment.md §2.6.
# Copia el contenido en la pestaña Environment de la aplicación y reemplaza cada <valor>.
# Son secretas: no las guardes en el repositorio ni las pases como argumentos de construcción.
# Lista completa y validación de las variables: apps/api/src/app/config.ts.
#
# No van aquí: NODE_ENV, HOST, PORT y WEB_DIST_DIR, que ya fija la imagen (Dockerfile), ni
# MIGRATION_DATABASE_URL o PROVISION_DATABASE_URL: el contenedor de la API no debe poder migrar ni dar
# de alta organizaciones (§2.5 y §2.10).
#
# Las opcionales van comentadas con su valor por defecto. Descoméntalas solo si cambias el valor:
# una variable vacía (por ejemplo `SMTP_USER=`) no cuenta como ausente y la API no arranca.

# --- Base de datos ---
# Conexión DIRECTA con el rol `iam_app` (nunca el administrador ni `iam_migrator`). Sin PgBouncer en
# modo transacción: el candado de instancia única necesita una sesión propia.
DATABASE_URL=postgres://iam_app:<contraseña>@<host>:5432/<base>?sslmode=require
# Conexiones simultáneas a la base (1 a 100).
# DB_POOL_MAX=10

# --- Origen ---
# Dominio exacto con el que se abre la app, con https y sin barra final. Lo comparan la protección
# contra CSRF y WebAuthn, y se usa en los enlaces de los correos.
APP_ORIGIN=https://<tu-dominio>

# --- Claves (AWS KMS, ADR 0020) ---
# En producción solo se admite `aws`: con `local` la API se niega a arrancar.
KMS_ADAPTER=aws
# Id, ARN o alias de la clave simétrica.
AWS_KMS_KEY_ID=<id-arn-o-alias-de-la-clave>
AWS_REGION=<region>
# Usuario IAM con permisos mínimos sobre la clave (kms:GenerateDataKey y kms:Decrypt). Las lee el SDK
# de AWS, no la configuración de la app.
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>

# --- Correo (SMTP del dominio) ---
# En producción solo se admite `smtp`.
MAIL_TRANSPORT=smtp
SMTP_HOST=<servidor-smtp>
# 587 con starttls, 465 con tls. `none` envía sin cifrar: no lo uses fuera de una red privada.
SMTP_PORT=587
SMTP_SECURITY=starttls
# Usuario y contraseña van juntos: pon los dos o ninguno.
SMTP_USER=<usuario-smtp>
SMTP_PASSWORD=<contraseña-smtp>
MAIL_FROM=no-reply@<tu-dominio>

# --- Proxy (§2.8) ---
# Déjalo en `false` hasta comprobar la IP que ve la API desde Traefik. Después: la IP o el CIDR del
# proxy, o `1` solo si la API es inalcanzable sin pasar por él.
TRUST_PROXY=false

# --- Opcionales ---
# fatal, error, warn, info, debug, trace o silent.
# LOG_LEVEL=info
# Nombre que muestra el autenticador al registrar una llave de acceso.
# WEBAUTHN_RP_NAME=Compass
# Publicador del outbox (ADR 0035), apagado salvo que se active a propósito; pausa de 500 a 60000 ms.
# OUTBOX_WORKER_ENABLED=false
# OUTBOX_POLL_INTERVAL_MS=5000
