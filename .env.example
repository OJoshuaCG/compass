# Configuración de la API para correrla en local contra una base de datos de PRUEBAS externa.
# Copia este archivo a `.env.local` (git lo ignora) y llena los valores. Guía: docs/deployment.md §1.1.
# Nunca pongas aquí credenciales de producción: la bóveda guarda secretos reales.
# Lista completa y validación de las variables: apps/api/src/app/config.ts.

# Conexión DIRECTA con el rol de la aplicación `iam_app` (nunca el administrador ni `iam_migrator`).
# Sin PgBouncer en modo transacción: el candado de instancia única necesita una sesión propia.
# Si el servidor exige TLS, agrega `?sslmode=require`.
DATABASE_URL=postgres://iam_app:<contraseña>@<host>:5432/<base>?sslmode=require

# Origen exacto con el que abrirás la app en el navegador. Usa `localhost`, no una IP:
# WebAuthn (llaves de acceso) exige un dominio. Debe coincidir con HOST y PORT.
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000

NODE_ENV=development
LOG_LEVEL=info

# Correo: `log` escribe los enlaces (invitaciones, restablecimientos) en el registro de la API.
MAIL_TRANSPORT=log

# Claves: archivo local de desarrollo. Se crea solo la primera vez; está ignorado por git.
# Los secretos de la bóveda cifrados con esta clave solo se pueden leer con ESTE archivo.
KMS_ADAPTER=local
LOCAL_KMS_KEY_FILE=.local-kms/kek.key

# Producción: KMS_ADAPTER=aws (el adaptador local se niega a arrancar con NODE_ENV=production).
# Con `aws` las dos variables son obligatorias y no pueden ir vacías; por eso están comentadas.
# Las credenciales de AWS no se definen aquí: las lee el SDK (AWS_ACCESS_KEY_ID y
# AWS_SECRET_ACCESS_KEY, o un rol IAM) desde el entorno del despliegue. Guía: docs/deployment.md §2.
# AWS_KMS_KEY_ID=<id, ARN o alias de la clave simétrica>
# AWS_REGION=<región de la clave>

# WEB_DIST_DIR lo fija el script `pnpm local:api` con una ruta absoluta; no hace falta aquí.

# Ancla diaria de la auditoría (solo la usa el comando `anchor-audit`, no la API; también lee DATABASE_URL).
# Bucket aparte en Wasabi con Object Lock; la credencial es de solo escritura y distinta de la de los
# respaldos. En local déjalas vacías: el comando no corre sin ellas. Guía: docs/runbooks/anchor-audit.md.
AUDIT_ANCHOR_S3_ENDPOINT=
AUDIT_ANCHOR_S3_REGION=
AUDIT_ANCHOR_S3_BUCKET=
AUDIT_ANCHOR_S3_ACCESS_KEY_ID=
AUDIT_ANCHOR_S3_SECRET_ACCESS_KEY=

# Proveedor OIDC (SSO, ADR 0050-0052). Apagado por defecto.
# OIDC_ENABLED=true exige OIDC_COOKIE_KEYS: una o varias claves (separadas por comas, la primera firma) de al
# menos 32 caracteres, p. ej. `openssl rand -base64 36`. Son secretos: no se versionan.
OIDC_ENABLED=false
# OIDC_COOKIE_KEYS=
# Algoritmo de firma de los id token (debe coincidir con la clave activa): ES256 (por omisión) o RS256.
OIDC_ID_TOKEN_ALG=ES256
# Redes privadas (IP o CIDR, separadas por comas) a las que Compass puede avisar de un cierre de sesión a los
# clientes OIDC marcados «red privada permitida». Vacío = solo direcciones públicas (lo recomendado).
# OIDC_BACKCHANNEL_PRIVATE_NETWORKS=
