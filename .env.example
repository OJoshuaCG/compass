# Configuración de la API para correrla en local contra una base de datos de PRUEBAS externa.
# Copia este archivo a `.env.local` (git lo ignora) y llena los valores. Guía: docs/deployment.md §1.1.
# Nunca pongas aquí credenciales de producción: la bóveda guarda secretos reales.
# Lista completa y validación de las variables: apps/api/src/app/config.ts.

# Conexión DIRECTA con el rol de la aplicación `iam_app` (nunca el administrador ni `iam_migrator`).
# Sin PgBouncer en modo transacción: el candado de instancia única necesita una sesión propia.
# Si el servidor exige TLS, agrega `?sslmode=require`.
DATABASE_URL=postgres://iam_app:<contraseña>@<host>:5432/<base>?sslmode=require

# Origen exacto con el que abrirás la app en el navegador. Usa `localhost`, no una IP:
# WebAuthn (llaves de acceso) exige un dominio. Debe coincidir con HOST y PORT.
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000

NODE_ENV=development
LOG_LEVEL=info

# Correo: `log` escribe los enlaces (invitaciones, restablecimientos) en el registro de la API.
MAIL_TRANSPORT=log

# Claves: archivo local de desarrollo. Se crea solo la primera vez; está ignorado por git.
# Los secretos de la bóveda cifrados con esta clave solo se pueden leer con ESTE archivo.
KMS_ADAPTER=local
LOCAL_KMS_KEY_FILE=.local-kms/kek.key

# WEB_DIST_DIR lo fija el script `pnpm local:api` con una ruta absoluta; no hace falta aquí.
