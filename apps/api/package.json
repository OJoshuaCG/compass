{
  "name": "@iam/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "provision": "node dist/main.provision.js",
    "recover-root": "node dist/main.recover-root.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.6",
    "@iam/contracts": "workspace:*",
    "@iam/db": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@node-rs/argon2": "2.2.2",
    "@simplewebauthn/server": "14.0.3",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "@zxcvbn-ts/language-es-es": "4.1.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "nodemailer": "10.1.7",
    "otplib": "13.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "rate-limiter-flexible": "11.2.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iam/config": "workspace:*",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.18",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
