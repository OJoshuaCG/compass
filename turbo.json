{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "DOCKER_HOST",
    "DOCKER_CONFIG",
    "TESTCONTAINERS_RYUK_DISABLED",
    "TESTCONTAINERS_HOST_OVERRIDE",
    "XDG_RUNTIME_DIR"
  ]
}
