{
  "name": "iam",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "turbo run e2e",
    "stack": "pnpm --filter @iam/api --filter @iam/web build && pnpm --filter @iam/e2e stack",
    "local:bootstrap": "pnpm --filter @iam/db build && node --env-file=.env.setup.local db/dist/cli.js bootstrap",
    "local:migrate": "pnpm --filter \"@iam/api...\" build && node --env-file=.env.setup.local apps/api/dist/main.migrate.js",
    "local:provision": "pnpm --filter \"@iam/api...\" build && node --env-file=.env.setup.local apps/api/dist/main.provision.js",
    "local:api": "pnpm --filter \"@iam/api...\" --filter @iam/web build && WEB_DIST_DIR=\"$PWD/apps/web/dist\" node --env-file=.env.local apps/api/dist/main.http.js"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
